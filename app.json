{
  "expo": {
    "name": "Zuno",
    "slug": "zuno-browser",
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zuno",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.zuno.browser",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.zuno.browser",
      "permissions": ["android.permission.INTERNET"],
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#08080E"
      }
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "./tools/with-network-hardening.js",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#08080E",
          "image": "./assets/images/icon.png",
          "imageWidth": 120
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
